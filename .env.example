# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Admin dashboard at /dashboard (invite codes, users, costs, traffic)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-long-password

# Anthropic Console → API Keys
ANTHROPIC_API_KEY=sk-ant-xxx

# Optional: AI models per role (defaults balance quality and cost)
# AI_MODEL=claude-opus-5-5            # task generator
# AI_GENERATOR_EFFORT=medium
# AI_VALIDATOR_MODEL=claude-sonnet-5-5
# AI_VALIDATOR_EFFORT=medium
# AI_EXPLAIN_MODEL=claude-opus-5-5    # explanations (cached per task)
# AI_CHAT_MODEL=claude-sonnet-5-5
# AI_NAME_MODEL=claude-haiku-5-5   # 5. pád jména, volá se jednou na jméno

# Optional: daily AI limits per user
# AI_DAILY_CHAT_LIMIT=60
# AI_DAILY_EXPLAIN_LIMIT=40
# AI_DAILY_GENERATE_LIMIT=40
