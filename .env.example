# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Admin dashboard at /dashboard (invite codes, users, costs, traffic)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-long-password

# Anthropic Console → API Keys
ANTHROPIC_API_KEY=sk-ant-xxx

# Push notifications – generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com   # defaults to the site URL

# Optional: AI models per role (defaults balance quality and cost)
# AI_MODEL=claude-opus-5-5            # task generator
# AI_MODEL_BY_TYPE=                   # per task type, e.g. slovni=claude-sonnet-5-5 – test first with npm run ab
# AI_GENERATOR_EFFORT=medium
# AI_FIRST_EFFORT=medium              # first draft (defaults to AI_GENERATOR_EFFORT)
# AI_REVISION_EFFORT=medium           # revision after a rejection (defaults to AI_GENERATOR_EFFORT)
# AI_VARIANT_MODEL=claude-haiku-5-5   # variants of validated maths/logic tasks
# AI_VARIANT_EFFORT=medium
# AI_WORDS_MODEL=claude-haiku-5-5     # proposes unused words for synonym / word-formation tasks
# AI_VALIDATOR_MODEL=claude-sonnet-5-5
# AI_VALIDATOR_EFFORT=medium
# AI_EXPLAIN_MODEL=claude-opus-5-5    # explanations of real Scio tasks (cached per task)
# AI_EXPLAIN_GEN_MODEL=claude-sonnet-5-5  # explanations of AI tasks (they bring the generator's trap analysis)
# AI_CHAT_MODEL=claude-sonnet-5-5
# AI_NAME_MODEL=claude-haiku-5-5   # 5. pád jména, volá se jednou na jméno

# Optional: daily AI limits per user
# AI_DAILY_CHAT_LIMIT=60
# AI_DAILY_EXPLAIN_LIMIT=40
# AI_DAILY_GENERATE_LIMIT=40
