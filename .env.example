# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Admin dashboard at /dashboard (invite codes, users, costs, traffic)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-long-password

# Anthropic Console → API Keys
ANTHROPIC_API_KEY=sk-ant-xxx

# Optional: AI model (default claude-opus-5-5). claude-haiku-5-5 is ~40× cheaper.
# AI_MODEL=claude-opus-5-5
# AI_VALIDATOR_MODEL=claude-opus-5-5

# Optional: daily AI limits per user
# AI_DAILY_CHAT_LIMIT=60
# AI_DAILY_EXPLAIN_LIMIT=40
# AI_DAILY_GENERATE_LIMIT=40
