{
  "name": "nanecisto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "check:math": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/check-math.ts",
    "pool": "tsx --conditions=react-server --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/generate-pool.ts",
    "pool:repeats": "tsx --conditions=react-server --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/pool-repeats.ts",
    "dev:demo": "DEMO_MODE=1 next dev --port 3001"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "katex": "^0.16.47",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
